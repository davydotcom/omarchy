#!/bin/bash

# omarchy:summary=Follow the accelerometer and rotate the built-in display to match
# omarchy:hidden=true

# Started from Hyprland autostart on machines that have an accelerometer.
# iio-sensor-proxy only samples the sensor while a client is listening, so this
# holds `monitor-sensor` open for the session and translates what it reports
# into Hyprland transforms. Rotate lock silences it without stopping it, so the
# next unlock picks up the orientation the device is already in.

set -uo pipefail

LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-display-autorotate.lock"
IIO_PATH="${OMARCHY_IIO_PATH:-/sys/bus/iio/devices}"
POLL_INTERVAL="${OMARCHY_AUTOROTATE_POLL_INTERVAL:-0.5}"
VERIFY_INTERVAL="${OMARCHY_AUTOROTATE_VERIFY_INTERVAL:-5}"
TABLET_ANGLE=200
TILT_THRESHOLD=7000
AXIS_MARGIN=1500
CONFIRM_SAMPLES=3

omarchy-hw-accelerometer || exit 0

# One reader per session. A second copy would claim the sensor for nothing and
# race this one to apply the same transform. The lock is held on this process
# rather than a subshell, so nothing outlives a kill of the pid Hyprland started.
exec 9>"$LOCK"
flock -n 9 || exit 0

sensor_pid=""
sensor_fd=""
raw_accelerometer=""
lid_angle_sensor=""
m00=1 m01=0 m02=0
m10=0 m11=1 m12=0
m20=0 m21=0 m22=1

stop_sensor() {
  [[ -n $sensor_pid ]] || return 0

  kill "$sensor_pid" 2>/dev/null
  wait "$sensor_pid" 2>/dev/null
  sensor_pid=""
}

# monitor-sensor keeps iio-sensor-proxy polling for as long as it stays
# connected, and it is a separate process from this one. Ending the session
# without taking it down leaves the sensor being read for nobody.
stop() {
  trap - EXIT
  stop_sensor
  exit 0
}
trap stop EXIT HUP INT TERM

# iio-sensor-proxy names the edge that is pointing up; Hyprland numbers the
# rotation applied to the output.
transform_for() {
  case "$1" in
    normal) echo 0 ;;
    left-up) echo 1 ;;
    bottom-up) echo 2 ;;
    right-up) echo 3 ;;
    *) return 1 ;;
  esac
}

discover_convertible_sensors() {
  local device label name matrix value

  raw_accelerometer=""
  lid_angle_sensor=""
  m00=1 m01=0 m02=0
  m10=0 m11=1 m12=0
  m20=0 m21=0 m22=1

  for device in "$IIO_PATH"/iio:device*; do
    [[ -d $device ]] || continue
    label=""
    name=""
    [[ -r $device/label ]] && label=$(<"$device/label")
    [[ -r $device/name ]] && name=$(<"$device/name")

    [[ $label == "accel-display" ]] && raw_accelerometer="$device"
    [[ $name == "cros-ec-lid-angle" ]] && lid_angle_sensor="$device/in_angl_raw"
  done

  [[ -r $raw_accelerometer/in_accel_x_raw &&
    -r $raw_accelerometer/in_accel_y_raw &&
    -r $raw_accelerometer/in_accel_z_raw &&
    -r $lid_angle_sensor ]] || return 1

  matrix=$(udevadm info --query=property --path="$raw_accelerometer" 2>/dev/null |
    sed -n 's/^ACCEL_MOUNT_MATRIX=//p')
  if [[ -n $matrix ]]; then
    matrix=${matrix//,/ }
    matrix=${matrix//;/ }
    read -r m00 m01 m02 m10 m11 m12 m20 m21 m22 <<<"$matrix"
    for value in "$m00" "$m01" "$m02" "$m10" "$m11" "$m12" "$m20" "$m21" "$m22"; do
      [[ $value =~ ^-?[01]$ ]] || return 1
    done
  fi
}

read_integer() {
  local file="$1" value

  value=$(<"$file") 2>/dev/null || return 1
  [[ $value =~ ^-?[0-9]+$ ]] || return 1
  printf '%s' "$value"
}

internal_monitor() {
  omarchy-hyprland-monitor-laptop
}

internal_enabled() {
  local monitor="$1"

  [[ -n $monitor ]] || return 1
  hyprctl monitors -j | jq -e --arg monitor "$monitor" \
    'any(.[]; .name == $monitor)' >/dev/null
}

apply_orientation() {
  local orientation="$1" transform monitor

  transform=$(transform_for "$orientation") || return 0

  # Rotate lock is checked here rather than around the reader so the sensor keeps
  # streaming: unlocking then applies the current orientation on the next event
  # instead of waiting for the device to be moved again.
  omarchy-toggle-enabled rotate-lock && return 0

  monitor=$(internal_monitor)
  internal_enabled "$monitor" || return 0

  # Transient: the accelerometer is the source of truth for as long as it is
  # unlocked, so it has no business rewriting what the display persists to.
  omarchy-display-orientation "$transform" --monitor "$monitor" --transient >/dev/null || return 0
}

# Framework 12 exposes a display accelerometer and EC hinge angle directly,
# while iio-sensor-proxy can select its unusable buffered interface and never
# emit an orientation. Reading the labelled display sensor also lets laptop
# mode stay upright instead of following accelerometer motion before the hinge
# has folded around.
read_convertible_sensor() {
  local lid raw_x raw_y raw_z x y abs_x abs_y
  local pending="" pending_count=0 applied="" verify_count=0 orientation

  while true; do
    lid=$(read_integer "$lid_angle_sensor") || return 1
    if (( lid < TABLET_ANGLE )); then
      orientation="normal"
    else
      raw_x=$(read_integer "$raw_accelerometer/in_accel_x_raw") || return 1
      raw_y=$(read_integer "$raw_accelerometer/in_accel_y_raw") || return 1
      raw_z=$(read_integer "$raw_accelerometer/in_accel_z_raw") || return 1

      # IIO mount matrices transform a row vector: [raw x y z] * matrix.
      x=$((raw_x * m00 + raw_y * m10 + raw_z * m20))
      y=$((raw_x * m01 + raw_y * m11 + raw_z * m21))
      abs_x=${x#-}
      abs_y=${y#-}

      if (( abs_x >= TILT_THRESHOLD && abs_x >= abs_y + AXIS_MARGIN )); then
        (( x < 0 )) && orientation="left-up" || orientation="right-up"
      elif (( abs_y >= TILT_THRESHOLD && abs_y >= abs_x + AXIS_MARGIN )); then
        (( y < 0 )) && orientation="normal" || orientation="bottom-up"
      else
        pending=""
        pending_count=0
        sleep "$POLL_INTERVAL"
        continue
      fi
    fi

    if [[ $orientation != "$pending" ]]; then
      pending="$orientation"
      pending_count=1
      verify_count=0
    else
      (( pending_count < CONFIRM_SAMPLES )) && ((pending_count += 1))
      if (( pending_count >= CONFIRM_SAMPLES )); then
        ((verify_count += 1))
        if omarchy-toggle-enabled rotate-lock; then
          # Keep the applied marker empty so unlocking reacts on the next
          # stable sample rather than waiting for the verification interval.
          applied=""
        elif [[ $orientation != "$applied" ]] || (( verify_count >= 20 )); then
          apply_orientation "$orientation"
          applied="$orientation"
          verify_count=0
        fi
      fi
    fi

    sleep "$POLL_INTERVAL"
  done
}

# monitor-sensor announces the orientation it starts with, then one line per
# change. Leading whitespace and the `===`/`+++` prefixes vary by version, so
# match on the phrase rather than the shape of the line.
read_sensor() {
  local line orientation=""

  omarchy-cmd-present monitor-sensor || return 1

  # Opened onto a descriptor rather than read from inline, so the reader's pid
  # is knowable and the loop still runs in this shell.
  exec {sensor_fd}< <(monitor-sensor --accel 2>/dev/null)
  sensor_pid=$!

  while true; do
    if read -r -t "$VERIFY_INTERVAL" line <&"$sensor_fd"; then
      case "$line" in
        *"Accelerometer orientation changed: "*) orientation="${line##*: }" ;;
        *"Has accelerometer (orientation: "*)
          orientation="${line##*orientation: }"
          orientation="${orientation%)}"
          ;;
        *) continue ;;
      esac

      apply_orientation "$orientation"
    elif kill -0 "$sensor_pid" 2>/dev/null; then
      # A reload drops transient monitor and input rules without causing a new
      # sensor event. Periodically replay the last orientation to repair them.
      [[ -n $orientation ]] && apply_orientation "$orientation"
    else
      break
    fi
  done

  exec {sensor_fd}<&-
  stop_sensor
}

# monitor-sensor exits when iio-sensor-proxy restarts or is not up yet at login.
# Back off rather than spin, and keep the session's rotation working once the
# daemon does appear.
delay=1
while true; do
  if discover_convertible_sensors; then
    read_convertible_sensor
  else
    read_sensor
  fi
  sleep "$delay"
  (( delay = delay * 2 > 30 ? 30 : delay * 2 ))
done
